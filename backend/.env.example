# Copy to .env and adjust as needed

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/database.db

# Data paths (relative to repo root by default)
DATA_DIR=./data

# FFmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Database encryption (optional)
# Set a strong passphrase to enable SQLCipher encryption.
# Requires: pip install sqlcipher3-binary
# WARNING: changing/removing this key after data exists will make the DB unreadable.
# DB_ENCRYPTION_KEY=your-strong-passphrase-here

# JWT authentication
# MUST change in production — any long random string works
# JWT_SECRET=change-me-in-production-please

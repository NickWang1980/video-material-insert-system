# Copy to .env and adjust as needed

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/database.db

# Data paths (relative to repo root by default)
DATA_DIR=./data

# FFmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Database encryption (optional)
# Set a strong passphrase to enable SQLCipher encryption.
# Requires: pip install sqlcipher3-binary
# WARNING: changing/removing this key after data exists will make the DB unreadable.
# DB_ENCRYPTION_KEY=your-strong-passphrase-here

# JWT authentication
# MUST change in production — any long random string works
# JWT_SECRET=change-me-in-production-please

# ── TTS (Qwen3-TTS) ──────────────────────────────────────────────────────────
# Base text-to-speech model. Override only if you fork the model.
# TTS_MODEL_NAME=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# After this many minutes of no /api/tts requests, the watchdog unloads cached
# TTS models from RAM/VRAM (~7 GB freed per model). Set 0 to disable auto-unload.
# TTS_IDLE_UNLOAD_MINUTES=15

# Enable the CustomVoice model (9 preset speakers: Vivian / Serena / Uncle_Fu /
# Dylan / Eric / Ryan / Aiden / Ono_Anna / Sohee). Adds ~1.7 GB download +
# ~3.4 GB GPU fp16 memory when loaded. Default off.
# Accepts: 1 / 0 / true / false / yes / no / on / off
# TTS_CUSTOM_VOICE_ENABLED=0

# HuggingFace cache root for TTS models. Defaults to {DATA_DIR}/qwen3_models.
# Use an absolute path or an explicit subdirectory if you want to share weights
# across projects (e.g., D:\\hf-cache\\qwen3).
# TTS_MODEL_CACHE_DIR=

# ── 文案生成 (Copy Gen) ──────────────────────────────────────────────────────
# Default OpenAI-compatible base_url（可在前端每个 ModelConfig 单独覆盖）。
# 国内常用：https://dashscope.aliyuncs.com/compatible-mode/v1 （阿里 Qwen）
# 国内常用：https://api.deepseek.com/v1 （DeepSeek）
# COPY_GEN_DEFAULT_BASE_URL=https://api.openai.com/v1

# 新建 ModelConfig 时默认填的模型名（仅是 UI 占位，不强制）。
# COPY_GEN_DEFAULT_MODEL=gpt-4o-mini

# 单次 LLM 调用硬超时（秒）。免费模型 / 长输出 建议 120–180。
# COPY_GEN_TIMEOUT=120

# Fernet 对称加密 key，用来加密 ModelConfig.api_key。
# 未设置时，后端会自动生成并写入 data/.copy_gen_key（请妥善备份；丢失等同 DB
# 中所有 api_key 不可读，需要重新填写）。
# 生成新 key 可以执行：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# COPY_GEN_LLM_KEY=

# ── 视频生成 (Video Gen / heygem 数字人 sidecar) ───────────────────────────
# heygem REST 服务的基础 URL。本机默认 127.0.0.1:8383；如部署在另一台机器，改
# 成 http://<host>:8383。空字符串等价于 disabled。
# HEYGEM_BASE_URL=http://127.0.0.1:8383

# 是否启用 heygem 后端调度。设为 0 时 /video-gen 页面显示"已禁用"提示；后端
# 拒绝创建任务（健康检查返回 enabled=false）。
# HEYGEM_ENABLED=1

# 单次 heygem 调用超时（秒）。经验值：参考视频时长 × 1.5 + 30。
# HEYGEM_REQUEST_TIMEOUT=600

# 显存协调策略：
#   manual       — Phase-1 默认。不做自动卸载，用户自己保证 TTS 与 heygem 不
#                  同时跑（前端会有状态提示）。
#   tts_unload   — 提交 heygem 任务前主动调 TTS unload_all() 释放 ~7 GB。
#                  Phase-2 实装。
#   cuda_isolate — 在 start_api.bat 注入 CUDA_VISIBLE_DEVICES=1，假设主机两张
#                  N 卡。Phase-2 实装。
# VIDEO_GEN_VRAM_STRATEGY=manual
